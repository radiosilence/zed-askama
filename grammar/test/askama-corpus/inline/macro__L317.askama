
        {%- macro test2() -%}
            {{ caller("bb") }}
        {%- endmacro -%}
        {%- macro test() -%}
            {{ caller("a") }}
            {%- call(b) test2() -%}
                five: {{ b }}
            {%~ endcall -%}
        {%- endmacro -%}
        {%- macro test3() -%}
