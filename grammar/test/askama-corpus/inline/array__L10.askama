
            {%- macro test_macro(title, my_arg = [""; 0]) -%}
                {{ title }}:
                {%- if !my_arg.is_empty() -%}
                    [
                    {%- for entry in my_arg -%}
                        {{ entry }},
                    {%- endfor -%}
                    ]
                {%- else -%}
                    []
                {%- endif -%}
            {%- endmacro -%}

            {{- test_macro("default") -}}
            {{- test_macro("set_empty", my_arg = [""; 0]) -}}
            {{- test_macro("set", my_arg = ["hello!"]) -}}
        